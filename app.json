{
  "expo": {
    "name": "Viviane Chidid",
    "slug": "viviane-chidid",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vivianechidid",
    "backgroundColor": "#190104",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#190104" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.vivianechidid.app", "infoPlist": { "UIBackgroundModes": ["audio"] } },
    "android": {
      "package": "com.vivianechidid.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["./plugins/no-audio-capture", "expo-secure-store", "expo-font", ["expo-screen-orientation", { "initialOrientation": "PORTRAIT_UP" }]]
  }
}
